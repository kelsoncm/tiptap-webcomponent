{
  "name": "@kelsoncm/tiptap-webcomponent",
  "version": "0.1.0",
  "description": "Web component <kelsoncm-tiptap>: editor de texto rico sobre @kelsoncm/tiptap-core, sem framework.",
  "license": "MIT",
  "author": "Kelson da Costa Medeiros <kelsoncm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelsoncm/tiptap-webcomponent.git"
  },
  "homepage": "https://github.com/kelsoncm/tiptap-webcomponent#readme",
  "bugs": "https://github.com/kelsoncm/tiptap-webcomponent/issues",
  "keywords": [
    "tiptap",
    "web-component",
    "custom-element",
    "wysiwyg",
    "editor",
    "rich-text"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": "./dist/kelsoncm-tiptap.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/kelsoncm-tiptap.bundle.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build --mode bundle && tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite demo --port 5181 --strictPort",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@kelsoncm/tiptap-core": "https://github.com/kelsoncm/tiptap-core/releases/download/v0.15.0/kelsoncm-tiptap-core-0.15.0.tgz",
    "@tiptap/core": "^3.35.0",
    "@tiptap/pm": "^3.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
